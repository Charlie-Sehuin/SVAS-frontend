# Copia este archivo a .env y completa los valores (doc conexión §10).
# Ninguna de estas claves es secreta: la anon key es pública por diseño.
# La SERVICE_ROLE_KEY y el JWT_SECRET NUNCA van aquí.

VITE_API_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: "true" para que el navegador use los mocks de MSW en vez de la API.
VITE_MSW=false
